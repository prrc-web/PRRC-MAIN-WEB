# Next.js Frontend Environment Variables

# API Configuration
## For proxy setups with nginx (recommended), set this to an empty string or '/api' to allow the frontend to use the same origin
## e.g. NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_API_URL_INTERNAL=http://payload-backend:3001

# (Optional) The canonical Payload admin + API server URL. When set this will
# be used to redirect /admin on the frontend to the backend admin UI. If you
# prefer to use a reverse proxy (nginx) with same-origin, set this to
# http://localhost:3001 (or the internal container hostname for compose).
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# App Configuration
PORT=3000
NODE_ENV=development

# Single admin path config
# Use this to control where frontend admin lives, default '/AdministrationPage'
NEXT_PUBLIC_FRONTEND_ADMIN_PATH=/AdministrationPage
# Backend admin (Payload) path. Default '/admin-panel'
NEXT_PUBLIC_BACKEND_ADMIN_PATH=/admin-panel
# Router mode: 'app' or 'pages' (optional)
NEXT_PUBLIC_ROUTER_MODE=app
