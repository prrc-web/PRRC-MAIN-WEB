# backend/.env.example — copy to .env and fill in real values.
# Do NOT commit the real .env file.

# MongoDB connection string. Use Atlas (as currently) or a local instance:
#   mongodb://localhost:27017/prrc          (local, no auth)
#   mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/prrc  (Atlas)
MONGODB_URI=mongodb://localhost:27017/prrc

# Secret used by Payload to encrypt cookies/tokens. Generate a new one for prod.
PAYLOAD_SECRET=change-me-generate-with-openssl-rand-hex-32

# Where the admin panel is served (matches nginx route -> backend:3001).
PAYLOAD_ADMIN_ROUTE=/admin
