{
  "name": "prrc-main-web",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "prepare": "husky install",
    "dev": "cd prrc-next-app && npm run dev",
    "dev:docker": "docker compose -f docker-compose.yml up --build",
    "clean:next": "cd prrc-next-app && rm -rf .next",
    "build": "cd prrc-next-app && npm run build",
    "start": "cd prrc-next-app && npm run start",
    "lint": "cd prrc-next-app && npm run lint",
    "lint:fix": "cd prrc-next-app && npm run lint:fix",
    "format": "cd prrc-next-app && npm run format",
    "type-check": "cd prrc-next-app && npm run type-check",
    "test": "cd prrc-next-app && npm run test",
    "start:dev": "concurrently \"cd payload-backend && npm run dev\" \"cd prrc-next-app && npm run dev\"",
    "check-admin-routes": "node scripts/check-admin-routes.js",
    "test:admin-config": "node scripts/test-admin-routes-export.js",
    "generate:types": "cd prrc-next-app && npx payload generate:types",
    "generate:types:log": "cd prrc-next-app && npx payload generate:types > logs/generate-types.log 2>&1 &"
  },
  "dependencies": {
    "@nextui-org/dropdown": "^2.1.25",
    "@nextui-org/system": "^2.2.1",
    "@nextui-org/theme": "^2.2.5",
    "@payloadcms/db-mongodb": "^3.56.0",
    "@payloadcms/next": "^3.56.0",
    "@payloadcms/richtext-slate": "^3.56.0",
    "autoprefixer": "^10.4.20",
    "framer-motion": "^11.2.10",
    "graphql": "^16.12.0",
    "next": "^15.0.3",
    "payload": "^3.56.0",
    "postcss": "^8.5.2",
    "prop-types": "^15.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.32.6",
    "tailwindcss": "^3.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^2.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "19.2.4",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.3.2",
    "typescript": "5.9.3",
    "husky": "^8.0.0",
    "lint-staged": "^15.0.0",
    "jest": "^30.2.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx|json|css|scss|md)": [
      "prettier --write"
    ]
  }
}